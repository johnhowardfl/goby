# --- API keys ---
ANTHROPIC_API_KEY=sk-ant-...
VOYAGE_API_KEY=pa-...

# --- Server ---
PORT=3001
# 64+ random hex chars; used to sign session cookies. Generate with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
SESSION_SECRET=change-me

# --- Models ---
ANTHROPIC_MODEL=claude-sonnet-4-6
VOYAGE_MODEL=voyage-3-lite

# --- App ---
# Set to true in production behind HTTPS reverse proxy
COOKIE_SECURE=false
# Public URL for invite links
PUBLIC_URL=http://localhost:3001

# --- Rate limiting (DDoS / abuse mitigation) ---
# Defaults are sane for production; override only if needed.
# Set true to disable app-layer rate limiting entirely (e.g. load testing).
RATE_LIMIT_DISABLED=false
# Coarse per-IP ceiling across all requests (volumetric flood protection).
RATE_LIMIT_GLOBAL_WINDOW_MS=60000
RATE_LIMIT_GLOBAL_MAX=300
# Per-IP limit on login/signup (brute-force + bcrypt CPU protection).
RATE_LIMIT_AUTH_WINDOW_MS=900000
RATE_LIMIT_AUTH_MAX=10
# Per-user limit on the chat endpoint (caps Anthropic/Voyage cost amplification).
RATE_LIMIT_CHAT_WINDOW_MS=60000
RATE_LIMIT_CHAT_MAX=20
